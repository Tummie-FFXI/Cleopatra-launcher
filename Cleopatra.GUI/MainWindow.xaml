<Window x:Class="Cleopatra.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Cleopatra XI"

        Width="1000"
        Height="720"

        MinWidth="900"
        MinHeight="650"

        WindowStartupLocation="CenterScreen"

        WindowStyle="None"
        ResizeMode="NoResize"

        Background="#101010">


    <!-- ==================================================
         RESOURCES
         ================================================== -->

    <Window.Resources>


        <!-- COLORS -->

        <SolidColorBrush x:Key="GoldBrush"
                         Color="#B89A63"/>

        <SolidColorBrush x:Key="MutedGoldBrush"
                         Color="#827052"/>

        <SolidColorBrush x:Key="IvoryBrush"
                         Color="#E8E3D8"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#96938C"/>


        <!-- ==================================================
             PLAY BUTTON
             ================================================== -->

        <Style x:Key="PlayButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#B89A63"/>

            <Setter Property="Foreground"
                    Value="#101010"/>

            <Setter Property="BorderBrush"
                    Value="#C6A970"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>


                            <!-- HOVER -->

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#C6A970"/>

                            </Trigger>


                            <!-- DISABLED -->

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Background"
                                        Value="#393630"/>

                                <Setter Property="Foreground"
                                        Value="#77736D"/>

                                <Setter Property="BorderBrush"
                                        Value="#514B40"/>

                                <Setter Property="Cursor"
                                        Value="Arrow"/>

                            </Trigger>


                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ==================================================
             TEXT BUTTON
             ================================================== -->

        <Style x:Key="TextButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource MutedGoldBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="Transparent">

                            <ContentPresenter/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


    </Window.Resources>


    <!-- ==================================================
         MAIN LAYOUT
         ================================================== -->

    <Grid>

        <Grid.RowDefinitions>

            <!-- Header -->
            <RowDefinition Height="75"/>

            <!-- Hero -->
            <RowDefinition Height="*"/>

            <!-- Update Area -->
            <RowDefinition Height="Auto"/>

            <!-- News -->
            <RowDefinition Height="180"/>

            <!-- Footer -->
            <RowDefinition Height="50"/>

        </Grid.RowDefinitions>


        <!-- ==================================================
             HEADER
             ================================================== -->

        <Border Grid.Row="0"
                Background="#151515"
                BorderBrush="#2B2925"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- BRAND -->

                <StackPanel Grid.Column="0"
                            Margin="28,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="CLEOPATRA XI"
                               Foreground="{StaticResource GoldBrush}"
                               FontSize="21"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="A FINAL FANTASY XI PRIVATE SERVER"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               Margin="1,3,0,0"/>

                </StackPanel>


                <!-- WINDOW CONTROLS -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right">

                    <Button Width="42"
                            Height="32"
                            Content="—"
                            Foreground="#77736B"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            Cursor="Hand"
                            Click="MinimizeButton_Click"/>

                    <Button Width="42"
                            Height="32"
                            Content="□"
                            Foreground="#77736B"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="11"
                            Cursor="Hand"
                            Click="MaximizeButton_Click"/>

                    <Button Width="42"
                            Height="32"
                            Content="×"
                            Foreground="#77736B"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="CloseButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ==================================================
             HERO
             ================================================== -->

        <Grid Grid.Row="1"
              Background="#101010">


            <!-- HERO ARTWORK -->

            <Image Source="/Cleopatra.GUI;component/Assets/launcher-hero.png"
                    Stretch="UniformToFill"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">


            </Image>


            <!-- DARK OVERLAY -->

            <Rectangle>

                <Rectangle.Fill>

                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="0,1">

                        <GradientStop Color="#35050505"
                                      Offset="0"/>

                        <GradientStop Color="#65050505"
                                      Offset="0.60"/>

                        <GradientStop Color="#B8050505"
                                      Offset="1"/>

                    </LinearGradientBrush>

                </Rectangle.Fill>

            </Rectangle>


            <!-- HERO CONTENT -->

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="340">


                <!-- ORNAMENT -->

                <TextBlock Text="◇  ─  ◇"
                           Foreground="{StaticResource MutedGoldBrush}"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>


                <!-- CLEOPATRA -->

                <TextBlock Text="CLEOPATRA"
                           Foreground="{StaticResource IvoryBrush}"
                           FontSize="42"
                           FontWeight="Light"
                           HorizontalAlignment="Center"/>


                <!-- GOLD LINE -->

                <Border Width="270"
                        Height="1"
                        Background="{StaticResource GoldBrush}"
                        Margin="0,12,0,28"/>


                <!-- ==================================================
                     SERVER INFORMATION
                     ================================================== -->

                <Grid Width="310">


                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <!-- LABELS -->

                    <StackPanel>

                        <TextBlock Text="SERVER STATUS"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"/>

                        <TextBlock Text="PLAYERS ONLINE"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   Margin="0,10,0,0"/>

                    </StackPanel>


                    <!-- VALUES -->

                    <StackPanel Grid.Column="1">


                        <!-- ONLINE -->

                        <StackPanel Orientation="Horizontal">

                            <Ellipse x:Name="ServerStatusDot"
                                     Width="8"
                                     Height="8"
                                     Fill="#66B878"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>

                            <TextBlock x:Name="ServerStatusText"
                                       Text="ONLINE"
                                       Foreground="{StaticResource IvoryBrush}"
                                       FontSize="11"/>

                        </StackPanel>


                        <!-- PLAYER COUNT -->

                        <TextBlock x:Name="PlayerCountText"
                                   Text="147"
                                   Foreground="{StaticResource IvoryBrush}"
                                   FontSize="11"
                                   Margin="15,10,0,0"/>


                    </StackPanel>

                </Grid>


                <!-- ==================================================
                     PLAY BUTTON
                     ================================================== -->

                <Button x:Name="PlayButton"
                        Content="PLAY XI"
                        Style="{StaticResource PlayButtonStyle}"
                        Width="285"
                        Height="55"
                        Margin="0,38,0,0"/>


            </StackPanel>

        </Grid>


        <!-- ==================================================
             UPDATE AREA
             ================================================== -->

        <Border x:Name="UpdatePanel"
                Grid.Row="2"
                Background="#171717"
                BorderBrush="#2B2925"
                BorderThickness="0,1">


            <StackPanel Margin="28,0">


                <!-- ==================================================
                     UPDATE SUMMARY
                     ================================================== -->

                <Grid Height="45">


                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <!-- STATUS -->

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">


                        <!-- STATUS ICON -->

                        <TextBlock x:Name="UpdateStatusIcon"
                                   Text="✓"
                                   Foreground="#7BB287"
                                   FontSize="12"
                                   Width="18"
                                   VerticalAlignment="Center"/>


                        <!-- STATUS MESSAGE -->

                        <TextBlock x:Name="UpdateStatusText"
                                   Text="Cleopatra is up to date"
                                   Foreground="{StaticResource IvoryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>


                    </StackPanel>


                    <!-- RIGHT SIDE -->

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">


                        <!-- DETAILS BUTTON -->

                        <Button x:Name="UpdateDetailsButton"
                                Content="Details ▾"
                                Style="{StaticResource TextButtonStyle}"
                                Margin="0,0,18,0"
                                Visibility="Collapsed"/>


                        <!-- RETRY BUTTON -->

                        <Button x:Name="RetryUpdateButton"
                                Content="RETRY"
                                Style="{StaticResource TextButtonStyle}"
                                Margin="0,0,18,0"
                                Visibility="Collapsed"/>


                        <!-- VERSION / FILE COUNT -->

                        <TextBlock x:Name="UpdateStatusMeta"
                                   Text="Version 1.0.3"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>


                    </StackPanel>


                </Grid>


                <!-- ==================================================
                     EXPANDED UPDATE PROGRESS
                     ================================================== -->

                <StackPanel x:Name="UpdateProgressPanel"
                            Visibility="Collapsed"
                            Margin="21,0,0,14">


                    <!-- CURRENT FILE -->

                    <Grid Margin="0,0,0,8">


                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>
                            <TextBlock x:Name="CurrentFileGroupText"
                                       Text="WEAPON SKILLS"
                                       Foreground="{StaticResource MutedGoldBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,2"/>

                            <TextBlock x:Name="CurrentFileNoteText"
                                       Text="Hume Dancer weapon skill effects"
                                       Foreground="#AAA69D"
                                       FontSize="11"/>
                        </StackPanel>


                        <TextBlock x:Name="UpdatePercentText"
                                   Grid.Column="1"
                                   Text="68%"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"/>


                    </Grid>


                    <!-- ==================================================
                         PROGRESS BAR
                         ================================================== -->

                    <Grid Height="3"
                          Background="#302D28">


                        <Grid.ColumnDefinitions>

                            <ColumnDefinition x:Name="ProgressCompletedColumn"
                                              Width="68*"/>

                            <ColumnDefinition x:Name="ProgressRemainingColumn"
                                              Width="32*"/>

                        </Grid.ColumnDefinitions>


                        <Border Grid.Column="0"
                                Background="{StaticResource GoldBrush}"/>


                    </Grid>


                    <!-- ==================================================
                         OPTIONAL FILE DETAILS
                         ================================================== -->

                    <StackPanel x:Name="UpdateFileDetailsPanel"
                                Visibility="Collapsed"
                                Margin="0,12,0,0">


                        <Border Height="1"
                                Background="#2B2925"
                                Margin="0,0,0,9"/>


                        <TextBlock x:Name="CurrentFilePathText"
                                   Text="ROM/27/82.DAT"
                                   Foreground="#8F8B83"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Margin="0,0,0,8"/>


                        <TextBlock Text="✓  ROM/0/1.DAT"
                                   Foreground="#8F8B83"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Margin="0,0,0,4"/>


                        <TextBlock Text="✓  ROM/27/81.DAT"
                                   Foreground="#8F8B83"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Margin="0,0,0,4"/>


                        <TextBlock Text="↓  ROM/27/82.DAT      68%"
                                   Foreground="{StaticResource GoldBrush}"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Margin="0,0,0,4"/>


                        <TextBlock Text="   ROM/27/83.DAT"
                                   Foreground="#8F8B83"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Margin="0,0,0,4"/>


                        <TextBlock Text="   ROM/119/51.DAT"
                                   Foreground="#8F8B83"
                                   FontFamily="Consolas"
                                   FontSize="10"/>


                    </StackPanel>


                </StackPanel>


            </StackPanel>

        </Border>


        <!-- ==================================================
             NEWS / LINKS
             ================================================== -->

        <Grid Grid.Row="3"
              Margin="28,22">


            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="1"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ==================================================
                 NEWS
                 ================================================== -->

            <StackPanel Grid.Column="0"
                        Margin="0,0,35,0">


                <TextBlock Text="NEWS"
                           Foreground="{StaticResource GoldBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,15"/>


                <!-- NEWS ITEM 1 -->

                <TextBlock Foreground="{StaticResource IvoryBrush}"
                           FontSize="12"
                           Margin="0,0,0,9">

                    <Run Text="OCT 02"
                         Foreground="{StaticResource MutedGoldBrush}"/>

                    <Run Text="     New Weaponskill Effects"/>

                </TextBlock>


                <!-- NEWS ITEM 2 -->

                <TextBlock Foreground="{StaticResource IvoryBrush}"
                           FontSize="12"
                           Margin="0,0,0,9">

                    <Run Text="SEP 28"
                         Foreground="{StaticResource MutedGoldBrush}"/>

                    <Run Text="     October Update"/>

                </TextBlock>


                <!-- NEWS ITEM 3 -->

                <TextBlock Foreground="{StaticResource IvoryBrush}"
                           FontSize="12">

                    <Run Text="SEP 20"
                         Foreground="{StaticResource MutedGoldBrush}"/>

                    <Run Text="     Server Notes"/>

                </TextBlock>


            </StackPanel>


            <!-- ==================================================
                 DIVIDER
                 ================================================== -->

            <Border Grid.Column="1"
                    Background="#302D28"/>


            <!-- ==================================================
                 LINKS
                 ================================================== -->

            <StackPanel Grid.Column="2"
                        Margin="35,0,0,0">


                <TextBlock Text="LINKS"
                           Foreground="{StaticResource GoldBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,15"/>


                <TextBlock Text="Website"
                           Foreground="{StaticResource IvoryBrush}"
                           FontSize="12"
                           Margin="0,0,0,9"/>


                <TextBlock Text="Discord"
                           Foreground="{StaticResource IvoryBrush}"
                           FontSize="12"
                           Margin="0,0,0,9"/>


                <TextBlock Text="Patch Notes"
                           Foreground="{StaticResource IvoryBrush}"
                           FontSize="12"/>


            </StackPanel>


        </Grid>


        <!-- ==================================================
             FOOTER
             ================================================== -->

        <Border Grid.Row="4"
                Background="#151515"
                BorderBrush="#2B2925"
                BorderThickness="0,1,0,0">


            <Grid Margin="28,0">


                <!-- SETTINGS -->

                <TextBlock Text="⚙  Settings"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>


                <!-- BRAND -->

                <TextBlock Text="CLEOPATRA XI"
                           Foreground="{StaticResource MutedGoldBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>


            </Grid>


        </Border>


    </Grid>

</Window>